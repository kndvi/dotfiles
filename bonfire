#!/bin/sh
# bootstrap script, safe to rerun
set -eu

echo '> installing essential packages'
case $(uname -s) in
    Linux)
        sudo apt-get update && sudo apt-get upgrade -y
        sudo apt-get install -y git bash tmux vim-gtk3 tree ncdu htop wl-clipboard universal-ctags
        sudo apt-get install -y ripgrep jq fwupd fonts-cascadia-code

        echo '> configuring fingerprint unlock'
        sudo apt-get install -y fprintd libpam-fprintd
        sudo pam-auth-update --enable fprintd

        echo '> configuring preferred gnome options'
        gsettings set org.gnome.shell.app-switcher current-workspace-only true
        gsettings set org.gnome.mutter workspaces-only-on-primary true
        gsettings set org.gnome.desktop.peripherals.touchpad tap-and-drag false
        gsettings set org.gnome.mutter dynamic-workspaces false
        gsettings set org.gnome.desktop.wm.preferences num-workspaces 5
        ;;
    Darwin)
        xcode-select -p >/dev/null 2>&1 || {
            echo '> installing command line tools for xcode'
            xcode-select --install
        }
        command -v brew >/dev/null 2>&1 || {
            echo '> installing homebrew'
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            eval "$(/opt/homebrew/bin/brew shellenv)"
        }
        brew update
        brew install git bash tmux tree ncdu htop universal-ctags ripgrep jq bash-completion@2 font-cascadia-mono
        ;;
    *)  echo '! unsupported os: only linux and mac' >&2; exit 1 ;;
esac

echo '> linking dotfiles'
mkdir -p ~/.config ~/work ~/lab ~/.claude/skills
ln -sfn "$(pwd)/.vimrc" ~/.vimrc
ln -sfn "$(pwd)/.tmux.conf" ~/.tmux.conf
ln -sfn "$(pwd)/.gitignore" ~/.gitignore
ln -sfn "$(pwd)/.psqlrc" ~/.psqlrc
ln -sfn "$(pwd)/.bashrc" ~/.bashrc
[ -f ~/.bash_profile ] || echo '[ -r ~/.bashrc ] && . ~/.bashrc' >> ~/.bash_profile

echo '> configuring claude'
ln -sfn "$(pwd)/claude/CLAUDE.md" ~/.claude/CLAUDE.md
cp -rf "$(pwd)/claude/skills/." ~/.claude/skills/

echo '> linking inventory scripts'
mkdir -p ~/.local/bin
for f in "$(pwd)/inventory"/*; do
    ln -sfn "$f" "$HOME/.local/bin/$(basename "$f")"
done

echo '> configuring git'
git config --global core.excludesFile ~/.gitignore
git config --global user.name 'Khoa Nguyen'
git config --global push.autoSetupRemote true
git config --global pull.rebase true
git config --global core.editor vim
git config --global diff.tool vimdiff
git config --global merge.tool vimdiff
git config --global mergetool.keepBackup false

[ "${SHELL##*/}" = bash ] && { echo '* default shell is already bash'; exit 0; }
bash_path=$(command -v bash || true)
[ -n "$bash_path" ] || { echo '! bash not found in path' >&2; exit 1; }

echo '> changing default shell to bash'
grep -qxF "$bash_path" /etc/shells || echo "$bash_path" | sudo tee -a /etc/shells

chsh -s "$bash_path"
echo '* please log out and log back in for shell change to take effect'
# vim: ft=sh
