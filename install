#!/bin/sh
set -eu

echo '> installing essential packages'
case $(uname -s) in
    Linux)
        sudo apt-get update && sudo apt-get upgrade -y
        sudo apt-get install -y git bash tree ncdu htop universal-ctags jq pandoc mutt sway
        sudo snap install ghostty --classic
        ;;
    Darwin)
        xcode-select -p >/dev/null 2>&1 || {
            echo '> installing command line tools for xcode'
            xcode-select --install
        }
        command -v brew >/dev/null 2>&1 || {
            echo '> installing homebrew'
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            eval "$(/opt/homebrew/bin/brew shellenv)"
        }
        brew update
        brew install git bash tree ncdu htop universal-ctags jq pandoc bash-completion@2 ghostty
        ;;
    *)  echo '! unsupported os: only linux and mac' >&2; exit 1 ;;
esac

echo '> linking dotfiles'
mkdir -p ~/.config
ln -sfn "$(pwd)/sway" ~/.config/sway
ln -sfn "$(pwd)/.vimrc" ~/.vimrc
ln -sfn "$(pwd)/ghostty" ~/.config/ghostty
ln -sfn "$(pwd)/.gitignore" ~/.gitignore
ln -sfn "$(pwd)/.psqlrc" ~/.psqlrc
ln -sfn "$(pwd)/.bashrc" ~/.bashrc
[ -f ~/.bash_profile ] || echo '[ -r ~/.bashrc ] && . ~/.bashrc' >> ~/.bash_profile

echo '> configuring llm agents'
mkdir -p ~/.claude
ln -sfn "$(pwd)/claude.md" ~/.claude/CLAUDE.md

echo '> configuring git'
git config --global core.excludesFile ~/.gitignore
git config --global push.autoSetupRemote true
git config --global pull.rebase true
git config --global diff.tool vimdiff
git config --global merge.tool vimdiff
git config --global mergetool.keepBackup false

[ "${SHELL##*/}" = bash ] && { echo '* default shell is already bash'; exit 0; }
bash_path=$(command -v bash || true)
[ -n "$bash_path" ] || { echo '! bash not found in path' >&2; exit 1; }

echo '> changing default shell to bash'
grep -qxF "$bash_path" /etc/shells || echo "$bash_path" | sudo tee -a /etc/shells

chsh -s "$bash_path"
echo '* please log out and log back in for shell change to take effect'
# vim: ft=sh
